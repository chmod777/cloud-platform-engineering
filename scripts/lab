#!/bin/bash
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TF="$ROOT/terraform/environments/dev"
PROJECT=cloud-platform-engineering-hs
MODE="${1:-}"
if [[ "$MODE" != start && "$MODE" != stop && "$MODE" != status ]]; then
  echo "Usage: scripts/lab {start|stop|status} [--plan]" >&2; exit 2
fi
if [[ $# -gt 2 || ( $# -eq 2 && ( "$2" != --plan || "$MODE" == status ) ) ]]; then
  echo "Only --plan is accepted for start/stop." >&2; exit 2
fi
if [[ "$MODE" == status ]]; then
  command -v gcloud >/dev/null
  echo "Project: $PROJECT — resource inventory; billing data is not included"
  gcloud compute instances list --project="$PROJECT" --format='table(name,zone.basename(),status)'
  gcloud compute disks list --project="$PROJECT" --format='table(name,zone.basename(),sizeGb,status,users)'
  gcloud compute addresses list --project="$PROJECT" --format='table(name,region.basename(),status,addressType)'
  echo "Also check Cloud Billing and other project services."
  exit
fi
for tool in terraform python3; do command -v "$tool" >/dev/null; done
# Prevent inherited CLI arguments from changing planning/applying behavior.
if env | LC_ALL=C grep -q '^TF_CLI_ARGS'; then
  echo "Unset TF_CLI_ARGS variables before running the lab." >&2; exit 1
fi
if [[ -n "${TF_WORKSPACE:-}" || -n "${TF_DATA_DIR:-}" ]]; then
  echo "Unset TF_WORKSPACE and TF_DATA_DIR before running the lab." >&2; exit 1
fi
[[ "$(terraform -chdir="$TF" workspace show)" == default ]] || { echo "The default workspace is required." >&2; exit 1; }
mkdir "$ROOT/.lab-lock" 2>/dev/null || { echo "Another operation may be running; check .lab-lock." >&2; exit 1; }
TMP=""
cleanup() { [[ -z "$TMP" ]] || rm -rf "$TMP"; rmdir "$ROOT/.lab-lock"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
TMP="$(mktemp -d "$ROOT/.lab-tmp.XXXXXX")"
ENABLED=false
[[ "$MODE" != start ]] || ENABLED=true
terraform -chdir="$TF" validate -no-color
terraform -chdir="$TF" plan -input=false -lock-timeout=30s \
  -var="project_id=$PROJECT" -var=region=europe-west9 \
  -var="lab_enabled=$ENABLED" -out="$TMP/plan.tfplan"
terraform -chdir="$TF" show -json "$TMP/plan.tfplan" > "$TMP/plan.json"
python3 "$ROOT/scripts/check-plan.py" "$MODE" "$TMP/plan.json"
if [[ "${2:-}" == --plan ]]; then echo "Plan validated. No changes applied."; exit; fi
if [[ "$MODE" == start ]]; then
  echo "The VM and disk in Belgium are billable. Check your credit balance and expiration in the console."
  echo "There is no automatic session timeout. Run lab-stop when finished."
fi
read -r -p "Apply this validated plan? Type yes: " ANSWER
[[ "$ANSWER" == yes ]] || { echo "Cancelled."; exit 0; }
terraform -chdir="$TF" apply -input=false -lock-timeout=30s "$TMP/plan.tfplan"
